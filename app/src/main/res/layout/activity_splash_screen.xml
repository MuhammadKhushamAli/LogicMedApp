<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SplashScreen">

    <TextView
        android:id="@+id/on_board_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/splashScreenTitle"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        />
    <RelativeLayout
        android:id="@+id/on_board_main_img_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/on_board_title"
        android:layout_above="@id/on_board_get_start_section"
        android:gravity="center"
        >
        <ImageView
            android:id="@+id/on_board_main_img"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:src="@drawable/splash_main"
            android:contentDescription="@string/mainImageDesc"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:src="@drawable/splash_sub"
            android:layout_alignBottom="@id/on_board_main_img"
            android:contentDescription="@string/subImageDesc"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/on_board_get_start_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="@drawable/get_start_section_bg"
        android:padding="20dp"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/splashScreenSubTitle"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginBottom="10dp"
            />
        <TextView
            android:id="@+id/on_board_term_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/termsAndPrivacyText"
            android:textSize="11sp"
            android:textAlignment="center"
            android:layout_marginBottom="10dp"
            />
        <com.example.logicmed.SlideToStart
            android:id="@+id/on_board_get_start_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/splash_screen_slider_bg"
            app:slider_text="@string/sliderText"
            app:slider_cover_color="@color/black"
            />

    </LinearLayout>

</RelativeLayout>
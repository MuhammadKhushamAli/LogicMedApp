<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DoctorDetailActivity">

    <ProgressBar
        android:id="@+id/doctor_detail_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/doctor_detail_go_back_btn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/arrow_back_icon"
        android:background="@drawable/ripple_subtle"
        android:contentDescription="@string/backArrow"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="12dp"
        android:elevation="100dp"
        android:padding="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="80dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/doctor_detail_image_section"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="100dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="false"
                app:strokeWidth="2dp"
                app:strokeColor="@color/accent_teal">
                <ImageView
                    android:id="@+id/doctor_detail_profile_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/avatar"
                    android:contentDescription="@string/profileImgDesc"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/doctor_detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.LogicMed.Headline"
                android:textAlignment="center"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/doctor_detail_fee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/amber_badge_bg"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                style="@style/TextAppearance.LogicMed.Accent.Amber"
                android:textSize="16sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/doctor_detail_timings_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/docTimingsTitle"
                style="@style/TextAppearance.LogicMed.Title"
                android:layout_marginBottom="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/doctor_detail_timings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/doctor_detail_categories_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/docCategoriesTitle"
                style="@style/TextAppearance.LogicMed.Title"
                android:layout_marginBottom="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/doctor_detail_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/doctor_detail_book_appointment_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bookAppointmentText"
        style="@style/Widget.LogicMed.Button.Primary"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/doctor_detail_start_conversation_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/startConversation"
        android:src="@drawable/chat_icon"
        android:layout_above="@id/doctor_detail_book_appointment_btn"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        app:backgroundTint="@color/accent_teal"
        app:tint="@color/bg_color"/>

    <FrameLayout
        android:id="@+id/appointment_booking_frag_container_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:background="@color/semi_transparent"
        android:elevation="100dp"
        android:backgroundTint="@color/semi_transparent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="12dp"
            app:cardCornerRadius="24dp"
            android:elevation="100dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="@color/secondary_color"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_subtle">
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/appointment_booking_frag_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</RelativeLayout>
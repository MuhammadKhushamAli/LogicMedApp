<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DoctorDetailActivity">
    <ImageButton
        android:id="@+id/doctor_detail_go_back_btn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/arrow_back_icon"
        android:background="@android:color/transparent"
        android:contentDescription="@string/backArrow"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="40dp"

            >
            <androidx.cardview.widget.CardView
                android:id="@+id/doctor_detail_image_section"
                android:layout_width="200dp"
                android:layout_height="200dp"
                app:cardCornerRadius="100dp"
                android:elevation="10dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="false"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"
                >
                <ImageView
                    android:id="@+id/doctor_detail_profile_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/avatar"
                    android:contentDescription="@string/profileImgDesc"
                    />
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/doctor_detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Muhammad Khusham Ali"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="20dp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/doctor_detail_image_section"
                />
            <TextView
                android:id="@+id/doctor_detail_fee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2000"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textAlignment="center"
                android:layout_below="@id/doctor_detail_name"
                />
            <TextView
                android:id="@+id/doctor_detail_timings_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/docTimingsTitle"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_below="@id/doctor_detail_fee"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/doctor_detail_timings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/doctor_detail_timings_title"
                />
            <TextView
                android:id="@+id/doctor_detail_categories_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/docCategoriesTitle"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_below="@id/doctor_detail_timings"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/doctor_detail_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/doctor_detail_categories_title"
                />
        </RelativeLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/doctor_detail_book_appointment_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bookAppointmentText"
        app:cornerRadius="10dp"
        android:backgroundTint="?button_color"
        android:layout_alignParentBottom="true"
        />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/doctor_detail_start_conversation_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/chat_icon"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        />

</RelativeLayout>
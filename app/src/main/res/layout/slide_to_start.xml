<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/slider_path"
    android:padding="10dp"
    android:gravity="center_vertical">
    <View
        android:id="@+id/slider_cover"
        android:layout_width="0dp"
        android:layout_height="50dp"
        />
    <com.example.logicmed.SliderButton
        android:id="@+id/slider_btn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="@string/sliderTickMarkDesc"
        android:background="@drawable/slider_icon_bg"
        android:layout_marginEnd="15dp"
        />
    <TextView
        android:id="@+id/slider_text"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_alignParentStart="true"
        android:gravity="center"
        />

</RelativeLayout>
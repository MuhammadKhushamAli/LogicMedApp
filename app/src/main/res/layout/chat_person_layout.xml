<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/ripple_subtle">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        android:layout_marginEnd="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_subtle">
        <ImageView
            android:id="@+id/chat_person_profile_pic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/avatar"
            android:contentDescription="@string/profileImgDesc"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/chat_person_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.LogicMed.Body"
        android:textStyle="bold"
        android:textColor="@color/text_primary"/>

</LinearLayout>
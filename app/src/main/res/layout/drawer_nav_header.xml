<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_height="match_parent"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:cardCornerRadius="100dp"
        app:cardUseCompatPadding="true"
        app:cardPreventCornerOverlap="false"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/accent_teal">
        <ImageView
            android:id="@+id/drawer_nav_profile_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/avatar"
            android:contentDescription="@string/profileImgDesc"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/drawer_nav_profile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.LogicMed.Body"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textAlignment="center"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/drawer_nav_profile_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.LogicMed.Caption"
        android:textAlignment="center"
        android:layout_marginTop="4dp"/>

</LinearLayout>